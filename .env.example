# The first id in <PROVIDER>_MODELS is that provider's default model — used whenever
# no --model flag / MELA_RUNTIME_MODEL is given and the agent declares no model of its own.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.4-mini,gpt-5.4
# OPENAI_MODEL=gpt-5.4-mini   # legacy single-model fallback, only used if OPENAI_MODELS is unset

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=meta/llama-3.1-70b-instruct,meta/llama-3.1-405b-instruct

MELA_RUNTIME_PROVIDER=openai
# MELA_RUNTIME_MODEL=gpt-5.4-mini   # explicit override; wins over every provider's own model list
MELA_RUNTIME_AGENT=default
MELA_RUNTIME_STORAGE=.runtime

# Optional: enables the pdf_ingest tool.
# Example: https://ingestionms-xxxxx-uc.a.run.app
MELA_INGESTION_BASE_URL=
MELA_INGESTION_BEARER_TOKEN=
MELA_INGESTION_API_KEY=
